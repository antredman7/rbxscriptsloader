local inspectedBoat = nil
local function findNearestBoat()
    local root = getRoot()
    if not root then return nil end
    local nearest, nearestDistance = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local seat = obj:FindFirstChildWhichIsA("VehicleSeat", true) or obj:FindFirstChildWhichIsA("Seat", true)
            if seat then
                local part = obj.PrimaryPart or seat
                local distance = (part.Position - root.Position).Magnitude
                if distance < nearestDistance then nearest, nearestDistance = obj, distance end
            end
        end
    end
    return nearest, nearestDistance
end
actionButton(boatLab, "Inspect nearest boat", "Count parts, seats, welds and report the closest seat-based model.", function()
    local boat, distance = findNearestBoat()
    if not boat then boatInfoText.Text = "No nearby model with a Seat or VehicleSeat was found."; notify("No boat found", RED); return end
    inspectedBoat = boat
    local parts, seats, welds = 0, 0, 0
    for _, item in ipairs(boat:GetDescendants()) do
        if item:IsA("BasePart") then parts += 1 end
        if item:IsA("Seat") or item:IsA("VehicleSeat") then seats += 1 end
        if item:IsA("Weld") or item:IsA("WeldConstraint") or item:IsA("Motor6D") or item:IsA("RigidConstraint") then welds += 1 end
    end
    boatInfoText.Text = string.format("Model: %s\nDistance: %.1f studs\nParts: %d  •  Seats: %d  •  Joints: %d", boat.Name, distance or 0, parts, seats, welds)
    notify("Boat inspected: " .. boat.Name)
end, ACCENT)
actionButton(boatLab, "Stop inspected boat motion", "Zero assembly velocities locally; server-owned physics may override this.", function()
    if not inspectedBoat or not inspectedBoat.Parent then notify("Inspect a boat first", RED); return end
    local count = 0
