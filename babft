    }, card)
    if description then
        make("TextLabel", {
            Size = UDim2.new(1, -90, 0, 18), Position = UDim2.fromOffset(13, 33),
            BackgroundTransparency = 1, Text = description, TextColor3 = MUTED,
            TextSize = 10, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
        }, card)
    end
    local button = make("TextButton", {
        Size = UDim2.fromOffset(44, 24), Position = UDim2.new(1, -58, 0.5, -12),
        BackgroundColor3 = initial and (accent or ACCENT) or Color3.fromRGB(62, 69, 86),
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
    }, card)
    round(button, 12)
    local knob = make("Frame", {
        Size = UDim2.fromOffset(18, 18), Position = UDim2.new(0, initial and 23 or 3, 0.5, -9),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, button)
    round(knob, 10)
    local state = initial
    local function paint(animate)
        local pos = UDim2.new(0, state and 23 or 3, 0.5, -9)
        local bg = state and (accent or ACCENT) or Color3.fromRGB(62, 69, 86)
        if animate then
            tween(knob, 0.15, { Position = pos })
            tween(button, 0.15, { BackgroundColor3 = bg })
        else
            knob.Position = pos
            button.BackgroundColor3 = bg
        end
    end
    local function setState(newState, skipCallback)
        state = newState
        paint(true)
        if not skipCallback and callback then callback(state) end
    end
    button.MouseButton1Click:Connect(function() setState(not state) end)
    return function(newState, skipCallback) setState(newState, skipCallback) end, function() return state end
end

local function sliderRow(page, label, minValue, maxValue, initial, callback)
    local card = make("Frame", { Size = UDim2.new(1, -4, 0, 76), BackgroundColor3 = PANEL, BorderSizePixel = 0 }, page)
    round(card, 10)
    local valueLabel = make("TextLabel", {
        Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(13, 9),
        BackgroundTransparency = 1, Text = label .. ": " .. tostring(initial), TextColor3 = TEXT,
        TextSize = 12, Font = Enum.Font.GothamSemibold, TextXAlignment = Enum.TextXAlignment.Left,
    }, card)
    local trackFrame = make("Frame", {
        Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 49),
        BackgroundColor3 = Color3.fromRGB(56, 64, 82), BorderSizePixel = 0,
    }, card)
    round(trackFrame, 5)
    local fraction = (initial - minValue) / (maxValue - minValue)
    local fill = make("Frame", { Size = UDim2.new(fraction, 0, 1, 0), BackgroundColor3 = ACCENT, BorderSizePixel = 0 }, trackFrame)
    round(fill, 5)
    local knob = make("TextButton", {
        Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(fraction, 0, 0.5, 0), BackgroundColor3 = Color3.new(1, 1, 1),
        Text = "", BorderSizePixel = 0, AutoButtonColor = false,
    }, trackFrame)
    round(knob, 10)
    local dragging = false
    local value = initial
    local function updateFromX(x)
        local width = math.max(trackFrame.AbsoluteSize.X, 1)
        local pct = math.clamp((x - trackFrame.AbsolutePosition.X) / width, 0, 1)
        value = math.floor(minValue + (maxValue - minValue) * pct + 0.5)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valueLabel.Text = label .. ": " .. tostring(value)
        callback(value)
    end
    knob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
    end)
    trackFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    local trackConnection = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateFromX(input.Position.X) end
    end)
    track(trackConnection)
    local endConnection = UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
    end)
    track(endConnection)
    return function(newValue)
        value = math.clamp(newValue, minValue, maxValue)
        local pct = (value - minValue) / (maxValue - minValue)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valueLabel.Text = label .. ": " .. tostring(value)
        callback(value)
    end
end

