local routes = pages.Routes
section(routes, "Saved route points", "Gold Farm visits Route Point 1, the middle, Route Point 2, moves 200 studs beyond the final point at Route Point 3's height to clear the last stage, then returns to the saved final endpoint. It repeats until stopped.")
local goldFarmToggle
goldFarmToggle = select(1, toggleRow(routes, "Gold Farm / Repeat route", "Repeats Route Point 1 → Middle → Route Point 2 → Last-stage clearance (200 studs forward only) → saved Final endpoint → Route Point 1 at constant travel speed, with no waypoint pauses.", false, function(enabled)
    goldFarmRunToken += 1
    local thisRunToken = goldFarmRunToken
    isRunning = enabled

    local function stillRunning()
        return isRunning and not destroyed and goldFarmRunToken == thisRunToken
    end

    if enabled then
        notify("Gold Farm started: Point 1 → Middle → End of levels → Clearance point → Saved final endpoint", GREEN)
        task.spawn(function()
            local ROUTE_SPEED = 375 -- studs per second; keep this constant across all route legs
            local middleCFrame = destinations[1].cframe:Lerp(destinations[2].cframe, 0.5)

            -- Route Point 3 is far below Route Point 2, so fly across at the
            -- end-of-level height first and descend only after passing the last stage.
            -- Extend ONLY the last-stage clearance waypoint 200 studs forward.
            -- The final endpoint itself stays at the exact saved Route Point 3,
            -- so the route still finishes at the intended end location.
            local point2Position = destinations[2].cframe.Position
            local finalPosition = destinations[3].cframe.Position
            local forward = Vector3.new(
                finalPosition.X - point2Position.X,
                0,
                finalPosition.Z - point2Position.Z
            )
            if forward.Magnitude < 0.001 then
                forward = Vector3.new(0, 0, 1)
            else
                forward = forward.Unit
            end

            local FINAL_STAGE_FORWARD_OFFSET = 200 -- applied to clearance waypoint only
            local extendedClearancePosition = finalPosition + forward * FINAL_STAGE_FORWARD_OFFSET
            local clearanceY = point2Position.Y
            local finalStageClearanceCFrame = CFrame.new(
                extendedClearancePosition.X,
                clearanceY,
                extendedClearancePosition.Z
            ) * destinations[3].cframe.Rotation

            local route = {
                destinations[1],
                { name = "Middle", cframe = middleCFrame },
                { name = "End of levels", cframe = destinations[2].cframe },
                { name = "Last stage clearance", cframe = finalStageClearanceCFrame },
                { name = "Final endpoint (descend only here)", cframe = destinations[3].cframe },
            }

            local function waitForRoot()
                local root = getRoot()
                while not root and stillRunning() do
                    RunService.Heartbeat:Wait()
                    root = getRoot()
                end
                if not stillRunning() then return nil end
                return root
            end

            local function moveConstantSpeedTo(targetCFrame)
                local root = waitForRoot()
                if not root then return false end

                local startCFrame = root.CFrame
                local distance = (startCFrame.Position - targetCFrame.Position).Magnitude
                if distance <= 0.01 then
                    -- Already at this waypoint: immediately advance, with no dwell or hold.
                    root.CFrame = targetCFrame
                    return stillRunning()
                end

                local startTime = os.clock()
                local duration = distance / ROUTE_SPEED
                while stillRunning() do
                    local currentRoot = getRoot()
                    if not currentRoot then
                        -- Do not turn AutoFarm off just because the character briefly respawned.
                        RunService.Heartbeat:Wait()
                    else
                        local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
                        -- Linear interpolation gives a constant positional rate per segment.
                        currentRoot.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                        if alpha >= 1 then
                            currentRoot.CFrame = targetCFrame
                            return true
                        end
                        RunService.Heartbeat:Wait()
                    end
                end
                return false
            end

            local cycleNumber = 0
            while stillRunning() do
                cycleNumber += 1
                for _, destination in ipairs(route) do
                    if not stillRunning() then break end
                    notify("Gold Farm moving to " .. destination.name, ACCENT)

                    -- Keep trying this same waypoint while enabled rather than silently
                    -- disabling the entire route if a character/root part is briefly absent.
                    local reached = false
                    while stillRunning() and not reached do
                        reached = moveConstantSpeedTo(destination.cframe)
                        if not reached and stillRunning() then
                            RunService.Heartbeat:Wait()
                        end
                    end
                    if not stillRunning() then break end
                    notify("Gold Farm reached " .. destination.name .. "; continuing", GREEN)

                    -- After the final endpoint only, wait 10 seconds and reset the
                    -- character. Then wait for the replacement character before the
                    -- next cycle starts, so the route does not try to fly a dead rig.
                    if destination.name == "Final endpoint (descend only here)" then
                        notify("Final endpoint reached; resetting in 10 seconds", ACCENT)
                        local resetDeadline = os.clock() + 10
                        while stillRunning() and os.clock() < resetDeadline do
                            RunService.Heartbeat:Wait()
                        end

                        if not stillRunning() then break end

                        local oldCharacter = getCharacter()
                        local humanoid = getHumanoid(oldCharacter)
                        local oldRoot = getRoot(oldCharacter)
                        if humanoid and humanoid.Health > 0 then
                            -- The final endpoint is below the map. Move to a safe spawn
                            -- BEFORE killing the humanoid so games that preserve the last
                            -- position during respawn do not respawn the player underground.
                            local safeSpawnCFrame = findSafeRespawnCFrame()
                            if oldRoot then
                                oldRoot.CFrame = safeSpawnCFrame
                                oldRoot.AssemblyLinearVelocity = Vector3.zero
                                oldRoot.AssemblyAngularVelocity = Vector3.zero
                                humanoid.Sit = false
                                humanoid.PlatformStand = false
                                -- Let the spawn-position change replicate before reset.
                                local settleDeadline = os.clock() + 0.3
                                while stillRunning() and os.clock() < settleDeadline do
                                    RunService.Heartbeat:Wait()
                                end
                            end

                            if not stillRunning() then break end
                            humanoid.Health = 0
                            notify("Resetting from safe spawn; waiting for respawn", ACCENT)

                            while stillRunning() do
                                local newCharacter = getCharacter()
                                if newCharacter and newCharacter ~= oldCharacter
                                    and getRoot(newCharacter) and getHumanoid(newCharacter) then
                                    break
                                end
                                RunService.Heartbeat:Wait()
                            end
                        else
                            notify("Could not reset: character humanoid was not available", RED)
                        end

                        if not stillRunning() then break end
                    end
                    -- No pause at intermediate waypoints; the 10-second wait occurs
                    -- only after reaching the final endpoint, as requested.
                end

                if stillRunning() then
                    notify("Gold Farm cycle " .. tostring(cycleNumber) .. " complete; repeating", GREEN)
                    -- Immediate next cycle: flies from the final endpoint back to Point 1.
                end
                RunService.Heartbeat:Wait()
            end
        end)
    else
        notify("Gold Farm stopped", MUTED)
    end
end, ACCENT))
