routePlaybackButton = actionButton(routes, "Start saved waypoint route", "Moves through saved waypoints in order. This is separate from Gold Farm.", function()
    if routePlaybackActive then routePlaybackActive = false; notify("Saved waypoint route stopped", MUTED); routePlaybackButton:FindFirstChildWhichIsA("TextLabel").Text = "Start saved waypoint route"; return end
    if #savedWaypoints == 0 then notify("Save at least one waypoint first", RED); return end
    routePlaybackActive = true
    routePlaybackButton:FindFirstChildWhichIsA("TextLabel").Text = "Stop saved waypoint route"
    notify("Saved waypoint route started")
    task.spawn(function()
        while routePlaybackActive and not destroyed do
            for _, waypoint in ipairs(savedWaypoints) do
                if not routePlaybackActive or destroyed then break end
                local root = getRoot()
                if root then
                    local startCFrame, targetCFrame = root.CFrame, waypoint.cframe
                    local duration = math.max((startCFrame.Position - targetCFrame.Position).Magnitude / 375, 0.05)
                    local startTime = os.clock()
                    while routePlaybackActive and not destroyed and os.clock() - startTime < duration do
                        local currentRoot = getRoot()
                        if not currentRoot then break end
                        currentRoot.CFrame = startCFrame:Lerp(targetCFrame, math.clamp((os.clock() - startTime) / duration, 0, 1))
                        currentRoot.AssemblyLinearVelocity = Vector3.zero
                        currentRoot.AssemblyAngularVelocity = Vector3.zero
                        RunService.Heartbeat:Wait()
                    end
                    if routePlaybackActive and not destroyed then local finalRoot = getRoot(); if finalRoot then finalRoot.CFrame = targetCFrame end end
                end
            end
            if routePlaybackActive then task.wait(0.25) end
        end
    end)
end, ACCENT)

