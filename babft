-- Main update loop: collision state, flight, local health regen, and live status.
track(RunService.Heartbeat:Connect(function(dt)
    if destroyed then return end
    local character = getCharacter()
    local humanoid = getHumanoid(character)
    local root = getRoot(character)

    if humanoid then
        if humanoid.WalkSpeed ~= walkSpeed and not flyActive then
            -- Respect the values configured in this menu when a character respawns.
            humanoid.WalkSpeed = walkSpeed
        end
        if humanoid.UseJumpPower and humanoid.JumpPower ~= jumpPower then humanoid.JumpPower = jumpPower end
        if regenActive and humanoid.Health > 0 then humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 20 * dt) end
        healthLabel.Text = string.format("Health: %d / %d", math.floor(humanoid.Health + 0.5), math.floor(humanoid.MaxHealth + 0.5))
    else
        healthLabel.Text = "Health: --"
    end

    if root then
        local p = root.Position
        positionLabel.Text = string.format("Position: %d, %d, %d", math.floor(p.X), math.floor(p.Y), math.floor(p.Z))
    else
        positionLabel.Text = "Position: character not ready"
    end
    local now = os.clock()
    local elapsed = now - lastFrameTime
    if elapsed > 0 then fpsValue = math.floor((fpsValue * 0.85) + ((1 / elapsed) * 0.15)) end
    lastFrameTime = now
    fpsLabel.Text = "FPS: " .. tostring(fpsValue)
    local pingText = "unavailable"
    pcall(function()
        local network = Stats:FindFirstChild("Network")
        local serverStats = network and network:FindFirstChild("ServerStatsItem")
        local dataPing = serverStats and serverStats:FindFirstChild("Data Ping")
        if dataPing then pingText = dataPing:GetValueString() end
    end)
    pingLabel.Text = "Ping: " .. tostring(pingText)
    if root then
        velocityLabel.Text = string.format("Velocity: %.1f studs/s", root.AssemblyLinearVelocity.Magnitude)
    else
        velocityLabel.Text = "Velocity: --"
    end
    if humanoid then
        stateLabel.Text = "Character state: " .. humanoid:GetState().Name
    else
        stateLabel.Text = "Character state: unavailable"
    end
    placeLabel.Text = string.format("Place ID: %d  •  Job: %s", game.PlaceId, game.JobId == "" and "Studio/local" or string.sub(game.JobId, 1, 8))
    if inspectedBoat and inspectedBoat.Parent then
        local boatRoot = inspectedBoat.PrimaryPart or inspectedBoat:FindFirstChildWhichIsA("BasePart", true)
        if boatRoot then boatSpeedText.Text = string.format("Boat speed: %.1f studs/s", boatRoot.AssemblyLinearVelocity.Magnitude) end
    else
        boatSpeedText.Text = "Boat speed: --"
    end

    if noclipActive and character then
        for _, item in ipairs(character:GetDescendants()) do
            if item:IsA("BasePart") then
                if originalCollisions[item] == nil then originalCollisions[item] = item.CanCollide end
                item.CanCollide = false
            end
        end
    end

    if flyActive and root then
        if not flyAttachment or flyAttachment.Parent ~= root then
            if flyVelocity then flyVelocity:Destroy() end
            if flyOrientation then flyOrientation:Destroy() end
            if flyAttachment then flyAttachment:Destroy() end
            flyAttachment = Instance.new("Attachment")
            flyAttachment.Name = "AutoFarmFlyAttachment"
            flyAttachment.Parent = root
            flyVelocity = Instance.new("LinearVelocity")
            flyVelocity.Name = "AutoFarmFlyVelocity"
            flyVelocity.Attachment0 = flyAttachment
            flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
            flyVelocity.VectorVelocity = Vector3.zero
            flyVelocity.MaxForce = math.huge
            flyVelocity.Parent = root
            flyOrientation = Instance.new("AlignOrientation")
            flyOrientation.Name = "AutoFarmFlyOrientation"
            flyOrientation.Attachment0 = flyAttachment
            flyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
            flyOrientation.Responsiveness = 18
            flyOrientation.MaxTorque = math.huge
            flyOrientation.Parent = root
        end
        local camera = workspace.CurrentCamera
        if camera then
            flyOrientation.CFrame = camera.CFrame.Rotation
            local direction = Vector3.zero
            if keysDown[Enum.KeyCode.W] then direction += camera.CFrame.LookVector end
            if keysDown[Enum.KeyCode.S] then direction -= camera.CFrame.LookVector end
            if keysDown[Enum.KeyCode.A] then direction -= camera.CFrame.RightVector end
            if keysDown[Enum.KeyCode.D] then direction += camera.CFrame.RightVector end
            if keysDown[Enum.KeyCode.Space] then direction += Vector3.yAxis end
            if keysDown[Enum.KeyCode.LeftShift] or keysDown[Enum.KeyCode.RightShift] then direction -= Vector3.yAxis end
            if direction.Magnitude > 0 then direction = direction.Unit * flySpeed end
            flyVelocity.VectorVelocity = direction
        end
    elseif flyVelocity or flyOrientation or flyAttachment then
        if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
        if flyOrientation then flyOrientation:Destroy(); flyOrientation = nil end
        if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end
    end
end))

