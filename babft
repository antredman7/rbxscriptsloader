end


-- Remember a safe starting position before AutoFarm moves the character to the
-- low final endpoint. This is a fallback if the place has no usable SpawnLocation.
local initialSafeCFrame = nil
task.spawn(function()
    local character = player.Character or player.CharacterAdded:Wait()
    local root = getRoot(character)
    while character and character.Parent and not root do
        task.wait()
        root = getRoot(character)
    end
    if root and root.Position.Y > workspace.FallenPartsDestroyHeight then
        initialSafeCFrame = root.CFrame
    end
end)

local function findSafeRespawnCFrame()
    local team = player.Team
    local bestCFrame = nil
    local bestDistance = math.huge

    -- Prefer a real, enabled Roblox SpawnLocation and respect team-only spawns.
    for _, instance in ipairs(workspace:GetDescendants()) do
        if instance:IsA("SpawnLocation") and instance.Enabled
            and instance.Position.Y > workspace.FallenPartsDestroyHeight + 25 then
            local teamAllowed = instance.Neutral or (team and instance.TeamColor == team.TeamColor)
            if teamAllowed then
                local spawnCFrame = instance.CFrame * CFrame.new(0, instance.Size.Y / 2 + 3, 0)
                local distance = initialSafeCFrame
                    and (spawnCFrame.Position - initialSafeCFrame.Position).Magnitude
                    or 0
                if not bestCFrame or distance < bestDistance then
                    bestCFrame = spawnCFrame
                    bestDistance = distance
                end
            end
        end
    end

    if bestCFrame then
        return bestCFrame
    end

    -- If the game uses a custom spawn system with no SpawnLocation instance,
    -- return to the character's original safe position. Route Point 1 is the
    -- last-resort fallback and is above the final endpoint in this route.
    if initialSafeCFrame then
        return initialSafeCFrame
    end
    return destinations[1].cframe + Vector3.new(0, 5, 0)
end

local function make(className, properties, parent)
    local object = Instance.new(className)
    for key, value in pairs(properties or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function round(object, radius)
    make("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, object)
end

local function stroke(object, color, transparency, thickness)
    make("UIStroke", {
        Color = color or Color3.fromRGB(57, 66, 88),
        Transparency = transparency or 0,
        Thickness = thickness or 1,
    }, object)
end

local function tween(object, duration, properties)
    local animation = TweenService:Create(object, TweenInfo.new(duration or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
    animation:Play()
    return animation
end

